# App
NUXT_PUBLIC_SITE_URL=http://localhost:3003
# Production: https://cards.untestcomplique.com

# Yjs public sync (run `npx y-websocket` locally on port 1234)
NUXT_PUBLIC_YJS_WEBSOCKET_URL=ws://localhost:1234

# Database (local: docker compose up -d)
DATABASE_URL=postgresql://quizwar:quizwar@localhost:5432/cards

# Auth
NUXT_SESSION_PASSWORD=
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=

# Email (Resend) — password reset; without keys, reset link is logged in dev
EMAIL_FROM=
RESEND_API_KEY=

# AI
GOOGLE_GENERATIVE_AI_API_KEY=

# Storage (MinIO/S3 compatible, same shape as Quizwar)
BUCKET_ENDPOINT=s3.quizwar.app
NUXT_BUCKET_ENDPOINT=s3.quizwar.app
NUXT_BUCKET_NAME=quizwar
NUXT_BUCKET_PUBLIC_URL=https://s3.quizwar.app
MINIO_USER=
MINIO_PASSWORD=
S3_ENDPOINT=https://s3.quizwar.app
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=quizwar
S3_PUBLIC_URL=https://s3.quizwar.app
